# ===== Django =====
DJANGO_DEBUG=False
# اتركه فارغاً ليُولَّد مفتاح خاص بكل نسخة تلقائياً (.secret_key) — لا تنسخه من عميل لآخر
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SESSION_COOKIE_AGE=28800
SESSION_SAVE_EVERY_REQUEST=True
SECURE_SSL_REDIRECT=False
USE_X_FORWARDED_HOST=True
USE_SECURE_PROXY_SSL_HEADER=True

# ===== حساب الدخول إلى التطبيق =====
APP_LOGIN_USERNAME=admin
APP_LOGIN_PASSWORD=CHANGE_ME

# ===== قاعدة بيانات التطبيق (سجلّات الدخول فقط) =====
# اترك DB_HOST فارغاً لاستخدام SQLite داخل data/
DB_HOST=
DB_PORT=3306
DB_NAME=item
DB_USER=item
DB_PASSWORD=CHANGE_ME
DB_CONN_MAX_AGE=60
DATA_DIR=./data

SYNC_SECRET=change-me-sync-secret
RATE_LIMIT_SEARCH_PER_MINUTE=60
RATE_LIMIT_SYNC_PER_HOUR=10
RATE_LIMIT_LOGIN_PER_10_MINUTES=20
RATE_LIMIT_LOGIN_WINDOW_SECONDS=120
SEARCH_QUERY_MAX_LEN=128

# ===== بيانات العميل =====
# بيانات أوراكل، السنة والوحدة، المخازن، ورابط خدمة أونكس تُدخل من شاشة
# «ربط أوراكل» (مدير النظام) وتُحفظ مشفّرة في قاعدة بيانات التطبيق.
# البرنامج لا يقرأها من هذا الملف إطلاقاً — أدخل الاتصال واضغط «اتصال وجلب البيانات».

# ===== خدمة أونكس Web Service — مهلات تقنية =====
ONYX_TIMEOUT=60
ONYX_QTY_TIMEOUT=45
ONYX_COMPARE_TIMEOUT=8
ONYX_COMPARE_CACHE_TTL=1800
ONYX_ITEMS_TIMEOUT=180

# ===== أوراكل أونكس — قراءة فقط (SELECT) — إعدادات تقنية =====
# التطبيق لا ينفّذ أي INSERT/UPDATE/DELETE على قاعدة أونكس.
# محلي Windows فقط: مسار Oracle Instant Client — اتركه فارغاً على Docker/Linux
ORACLE_CLIENT_LIB_DIR=
ORACLE_TCP_CONNECT_TIMEOUT=20
ORACLE_CALL_TIMEOUT_MS=120000
ORACLE_RETRY_COUNT=3
ORACLE_RETRY_DELAY=2
ORACLE_POOL_EXPIRE_TIME=4

PORT=8000
WEB_CONCURRENCY=4
GUNICORN_TIMEOUT=1800
